# `npm run dev:emulator`: sign-in against the local Firebase Auth emulator (no real Google project, nothing leaves this computer).
# Start it with: npx firebase-tools emulators:start --only auth --project demo-quietnet
# and run the backend with FIREBASE_PROJECT_ID=demo-quietnet FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-quietnet
VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
