# Hosted build (Firebase): the dashboard talks to the QuietNet API on the VM. No token here: the owner enters it once per browser.
VITE_API_BASE=https://api.quietnet.in
# If you change this, also change connect-src in firebase.json's Content-Security-Policy, or the dashboard can't reach it.

# Sign-in with Firebase Authentication (project cobalt-skies, web app "QuietNet"). Public by design: these identify
# the project to Google, they don't grant access. The server checks each sign-in itself (FIREBASE_PROJECT_ID).
VITE_FIREBASE_API_KEY=AIzaSyC7Y7Us-Z2XwD17i-26PQhTMmoTGqq-Ksw
# Google's sign-in screen names this domain ("to continue to quietnet.in"). Firebase Hosting serves the sign-in
# handler at quietnet.in/__/auth/handler; that URL must be an authorized redirect URI of the project's OAuth client.
VITE_FIREBASE_AUTH_DOMAIN=quietnet.in
VITE_FIREBASE_PROJECT_ID=cobalt-skies
VITE_FIREBASE_APP_ID=1:522769682814:web:d18ba5fb4bbe26bf1d232f
