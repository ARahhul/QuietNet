# Copy to backend/.env and fill in. Never commit .env.

# AdGuard Home admin API, reached through the SSH tunnel (infra/tunnel.ps1).
# Local dev without a VM: run the fake (python -m devtools.fake_adguard --port 3100) and use http://127.0.0.1:3100
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USER=admin
ADGUARD_PASS=change-me
# Restrict port 53 / DoT / DoH to known devices (allowed_clients). Keep true on a real VM.
ADGUARD_LOCK_ACCESS=true

# DNS names devices use: <client-id>.dns.<domain> (DoT) and https://dns.<domain>/dns-query/<client-id> (DoH)
DNS_HOSTNAME=dns.pahra.app
# Public IP of the VM, shown in router / manual-DNS steps
VM_IP=

# Gemini (optional). Without a key, cards use list/seed text and the TV assistant runs in guided mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or any OpenAI-compatible endpoint instead (wins when set), e.g. AICredits:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

DB_PATH=pahra.db
LISTS_CACHE_DIR=.cache/lists
# true = never download lists; use the bundled samples (offline demo)
OFFLINE_LISTS=false
POLL_INTERVAL_S=30
EVENT_RETENTION_DAYS=7

# Bearer token the dashboard sends (frontend: VITE_API_TOKEN must match)
API_TOKEN=dev-token

# Home companion MCP server (TV discovery / ADB). Found on PATH or in ../companion/.venv automatically.
COMPANION_ENABLED=true
COMPANION_COMMAND=pahra-companion

# Dashboard origins allowed to call the API: local Vite, plus the hosted build (Firebase) when the API is public
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://quietnet.in,https://quietnet.web.app
