# Copy to backend/.env and fill in. Never commit .env.

# AdGuard Home admin API, reached through the SSH tunnel (infra/tunnel.ps1).
# Local dev without a VM: run the fake (python -m devtools.fake_adguard --port 3100) and use http://127.0.0.1:3100
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USER=admin
ADGUARD_PASS=change-me
# Restrict port 53 / DoT / DoH to known devices (allowed_clients). Keep true on a real VM.
ADGUARD_LOCK_ACCESS=true
# Unknown addresses (a home whose IP just changed): rescue = answer only Dynamic DNS / time / QuietNet names and
# block the rest at once, so the router can report its new address; drop = no answer at all.
ADGUARD_UNKNOWN_CLIENTS=rescue

# DNS names devices use: <client-id>.dns.<domain> (DoT) and https://dns.<domain>/dns-query/<client-id> (DoH)
DNS_HOSTNAME=dns.pahra.app
# Public IP of the VM, shown in router / manual-DNS steps
VM_IP=

# Gemini (optional). Without a key, cards use list/seed text and the TV assistant runs in guided mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or any OpenAI-compatible endpoint instead (wins when set), e.g. AICredits:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# The same key also writes Home WiFi guides for providers / routers not in pahra/data/providers.yaml.

# Langfuse (optional): a trace for every AI call (domain explanations, Home WiFi guides, TV assistant)
# and the prompts in pahra/prompts.py, kept in Langfuse Prompt Management. Edit a prompt there and its
# "production" version is what runs; `python -m pahra.tracing push-prompts --update` restores the code's text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# Setup → Home WiFi detects the visitor's provider from their IP (Team Cymru, asked over
# Cloudflare DNS-over-HTTPS). false = never send the IP out; users pick their provider instead.
PROVIDER_LOOKUP=true

DB_PATH=pahra.db
LISTS_CACHE_DIR=.cache/lists
# true = never download lists; use the bundled samples (offline demo)
OFFLINE_LISTS=false
POLL_INTERVAL_S=30
EVENT_RETENTION_DAYS=7

# The operator's token (scripts, and dashboards from before sign-in). It means the first account.
API_TOKEN=dev-token
# Sign-in with Firebase Authentication: each person gets their own account and sees only their own devices.
# The Firebase project id (frontend: VITE_FIREBASE_* from `firebase apps:sdkconfig web`). Empty = token only.
FIREBASE_PROJECT_ID=
# Local development only, never on a server: trust the Firebase Auth emulator's unsigned tokens.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Home companion MCP server (TV discovery / ADB). Found on PATH or in ../companion/.venv automatically.
COMPANION_ENABLED=true
COMPANION_COMMAND=pahra-companion

# Dashboard origins allowed to call the API: local Vite, plus the hosted build (Firebase) when the API is public
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://quietnet.in,https://quietnet.web.app

# Per-account rate limits (pahra/ratelimit.py: the AI features, device changes, wrong sign-ins). Turn off only for local scripts.
# RATE_LIMIT_ENABLED=true
