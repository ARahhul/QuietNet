# Caddy for the all-in-the-cloud setup (docker-compose.cloud.yml).
{
	# Only :443 is open on the VM, so no HTTP->HTTPS redirect listener.
	auto_https disable_redirects
}

# Response headers for both names: HTTPS only, no framing, no MIME sniffing, no referrer, no server banner.
(hardened) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Nothing here is a web page: JSON and DNS answers never need to load anything.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
}

# DoH for devices: https://dns.<domain>/dns-query/<client-id>. AdGuard's login page stays hidden.
{$DNS_HOST}:443 {
	import hardened
	tls /etc/letsencrypt/live/{$DNS_HOST}/fullchain.pem /etc/letsencrypt/live/{$DNS_HOST}/privkey.pem

	@doh path /dns-query /dns-query/*
	handle @doh {
		# AdGuard reads the ClientID from /dns-query/<client-id>; it trusts X-Forwarded-For from trusted_proxies
		reverse_proxy adguardhome:3000
	}
	handle {
		respond 404
	}
}

# QuietNet API for the dashboard (quietnet.in). Caddy gets this certificate itself over :443 (TLS-ALPN).
{$API_HOST}:443 {
	import hardened
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip
	reverse_proxy backend:8000
}
